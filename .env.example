# Database
DATABASE_URL="file:./.clipcode/db.sqlite"

# Redis (for queue)
REDIS_URL="redis://localhost:6379"

# Cloudflare R2 (for hosted video URLs)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="clipcode"

# LLM (optional - defaults to local Ollama)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# OpenAI (fallback)
OPENAI_API_KEY=""

# Anthropic (fallback)
ANTHROPIC_API_KEY=""